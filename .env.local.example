# Meta Conversions API
META_DATASET_ID=your_pixel_dataset_id_here
META_ACCESS_TOKEN=your_system_user_access_token_here
META_TEST_EVENT_CODE=TEST76882   # удали эту строку в продакшене

# Yandex Metrica counter ID (публичная переменная — вставляется в HTML)
NEXT_PUBLIC_YM_ID=12345678

# APIPAY webhook signature secret (выдаётся в дашборде ApiPay при настройке webhook'а,
# не совпадает с API Key). Используется для HMAC-SHA256 валидации X-Webhook-Signature.
APIPAY_WEBHOOK_SIGNATURE_SECRET=replace_with_value_from_apipay_dashboard

# Admin panel — Basic Auth для /admin/*
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_random_password

# Убрать в проде — только для тестирования
