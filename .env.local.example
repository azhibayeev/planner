# Meta Conversions API
META_DATASET_ID=your_pixel_dataset_id_here
META_ACCESS_TOKEN=your_system_user_access_token_here
META_TEST_EVENT_CODE=TEST76882   # удали эту строку в продакшене

# APIPAY webhook secret (любая случайная hex-строка, генерируется через `openssl rand -hex 32`)
APIPAY_WEBHOOK_SECRET=replace_with_random_64_char_hex

# Admin panel — Basic Auth для /admin/*
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_random_password

# Убрать в проде — только для тестирования
